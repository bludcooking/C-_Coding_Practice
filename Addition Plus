#include <iostream>
using namespace std;

int add(int a, int b) {
    return a + b;
}

int main() {
    int num1, num2;

    cout << "Enter first number: ";
    cin >> num1;

    cout << "Enter second number: ";
    cin >> num2;

    int sum = add(num1, num2);
    cout << "The sum is: " << sum << endl;

    for (int i = 1; i <= 5; i++) {
        cout << "Count: " << i << endl;
    }

    if (num1 > num2) {
        cout << num1 << " is greater than " << num2 << endl;
    } else {
        cout << num2 << " is greater than or equal to " << num1 << endl;
    }

    return 0;
}
