#include <iostream>
#include <complex>
using namespace std;
int main() {
    for (int y = 0; y < 20; y++) {
        for (int x = 0; x < 40; x++) {
            complex<double> c(-2.0 + x*3.0/40, -1.5 + y*3.0/20);
            complex<double> z(0, 0);
            for (int i = 0; i < 100; i++) {
                z = z*z + c;
                if (abs(z) > 2) break;
            }
            cout << (abs(z) < 2 ? "*" : " ");
        }
        cout << endl;
    }
    return 0;
}
